// ======================================================
// Gestão de Projetos Web
// Banco: PostgreSQL
// ORM: Prisma
// Versão: MVP Interno
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum PlanType {
  INTERNAL
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  REQUESTER
  VIEWER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELED
}

enum TaskStatus {
  PLANNED
  TODO
  DOING
  DONE
  CANCELED
}

enum ServiceOrderStatus {
  OPEN
  IN_REVIEW
  IN_PROGRESS
  WAITING_REQUESTER
  COMPLETED
  CANCELED
}

enum RefType {
  PROJECT
  TASK
  SERVICE_ORDER
  SERVICE_ORDER_TASK
  DAILY_LOG
}

enum DailyLogStatus {
  COMPLETED
  IN_PROGRESS
  PENDING
  WAITING_RETURN
}

enum DailyLogVisibility {
  PRIVATE
  SUPERVISION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  STATUS_CHANGE
  COMMENT
  ATTACHMENT
  ASSIGN
  COMPLETE
  CANCEL
  SATISFACTION_SUBMITTED
  SATISFACTION_LOW_RATING_RECEIVED
  SATISFACTION_FOLLOWUP_UPDATED
}

enum SatisfactionFollowUpStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum BillingStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PermissionModule {
  DASHBOARD
  SERVICE_ORDERS
  PROJECTS
  TASKS
  KANBAN
  DAILY_LOGS
  SCHEDULE
  USERS
  REQUESTER_PORTAL
  SETTINGS
  LOOKUPS
  SATISFACTION
}

enum LookupType {
  UNIT
  DEPARTMENT
  SERVICE_ORDER_CATEGORY
  SYSTEM_PROCESS
  PROJECT_TYPE
  CANCELLATION_REASON
}

enum LookupRelatedModule {
  SERVICE_ORDER
  PROJECT
  TASK
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

enum NotificationEntity {
  SERVICE_ORDER
  PROJECT
  TASK
  DAILY_LOG
  USER
  PERMISSION
  SYSTEM
  SATISFACTION
}

// ======================================================
// TENANT / CONTA
// ======================================================

model Tenant {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  status        TenantStatus  @default(ACTIVE)
  plan          PlanType      @default(INTERNAL)
  billingStatus BillingStatus @default(NONE)

  users             User[]
  projects          Project[]
  tasks             Task[]
  serviceOrders     ServiceOrder[]
  serviceOrderTasks ServiceOrderTask[]
  comments          Comment[]
  attachments       Attachment[]
  dailyLogs         DailyLog[]
  auditLogs         AuditLog[]
  rolePermissions   RolePermission[]
  notifications     Notification[]
  settings          TenantSettings?
  lookupItems       LookupItem[]
  satisfactions     ServiceOrderSatisfaction[]
  notificationPreferences UserNotificationPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
}

model TenantSettings {
  id                               String   @id @default(uuid())
  tenantId                         String   @unique
  environmentName                  String?
  institutionName                  String?
  environmentDescription           String?
  allowedEmailDomain               String?
  requesterSelfRegistrationEnabled Boolean  @default(true)
  internalNotificationsEnabled     Boolean  @default(true)
  operationalEmailsEnabled         Boolean  @default(true)
  deadlineAlertsEnabled            Boolean  @default(true)
  defaultServiceOrderDeadlineDays  Int?
  defaultTaskDeadlineDays          Int?
  defaultProjectDeadlineDays       Int?
  tenant                           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@index([tenantId])
}

model LookupItem {
  id            String               @id @default(uuid())
  tenantId      String
  type          LookupType
  name          String
  normalizedName String
  code          String?
  description   String?
  parentId      String?
  relatedModule LookupRelatedModule?
  isActive      Boolean              @default(true)
  sortOrder     Int?
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent        LookupItem?          @relation("LookupHierarchy", fields: [parentId], references: [id])
  children      LookupItem[]         @relation("LookupHierarchy")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([tenantId, type, normalizedName])
  @@index([tenantId, type, isActive])
  @@index([tenantId, parentId])
}

// ======================================================
// USUÁRIOS / AUTENTICAÇÃO
// ======================================================

model User {
  id       String @id @default(uuid())
  tenantId String

  name         String
  email        String
  passwordHash String
  role         UserRole   @default(REQUESTER)
  status       UserStatus @default(PENDING)

  phone     String?
  avatarUrl String?

  lastLoginAt            DateTime?
  emailVerifiedAt        DateTime?
  mustChangePassword     Boolean   @default(false)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  passwordResetUsedAt    DateTime?
  inviteTokenHash        String?
  inviteExpiresAt        DateTime?
  invitedAt              DateTime?
  inviteAcceptedAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ownedProjects Project[] @relation("ProjectOwner")
  assignedTasks Task[]    @relation("TaskAssignee")

  requestedServiceOrders    ServiceOrder[]     @relation("ServiceOrderRequester")
  responsibleServiceOrders  ServiceOrder[]     @relation("ServiceOrderResponsible")
  assignedServiceOrderTasks ServiceOrderTask[] @relation("ServiceOrderTaskResponsible")

  comments      Comment[]
  attachments   Attachment[]
  dailyLogs     DailyLog[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  notificationPreference UserNotificationPreference?
  submittedSatisfactions ServiceOrderSatisfaction[] @relation("SatisfactionRequester")
  followedUpSatisfactions ServiceOrderSatisfaction[] @relation("SatisfactionFollowedUpBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([role])
  @@index([status])
  @@index([passwordResetTokenHash])
  @@index([inviteTokenHash])
}

model UserNotificationPreference {
  id                              String   @id @default(uuid())
  tenantId                        String
  userId                          String   @unique
  internalNotificationsEnabled    Boolean  @default(true)
  emailNotificationsEnabled       Boolean  @default(true)
  serviceOrderUpdatesEmail        Boolean  @default(true)
  serviceOrderCommentsEmail       Boolean  @default(true)
  serviceOrderAttachmentsEmail    Boolean  @default(true)
  projectUpdatesEmail             Boolean  @default(true)
  projectCommentsEmail            Boolean  @default(true)
  taskUpdatesEmail                Boolean  @default(true)
  taskCommentsEmail               Boolean  @default(true)
  deadlineAlertsEmail             Boolean  @default(true)
  satisfactionAlertsEmail         Boolean  @default(true)
  dailySummaryEmail               Boolean  @default(false)
  tenant                          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String

  tokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ======================================================
// PROJETOS
// ======================================================

model Project {
  id       String @id @default(uuid())
  tenantId String
  ownerId  String

  title       String
  description String?
  area        String?
  unit        String?
  type        String?
  tags        String?

  priority Priority      @default(MEDIUM)
  status   ProjectStatus @default(PLANNED)

  startDate  DateTime?
  dueDate    DateTime?
  finishedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  tasks       Task[]
  comments    Comment[]
  attachments Attachment[]
  dailyLogs   DailyLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ======================================================
// TAREFAS DE PROJETOS
// ======================================================

model Task {
  id         String  @id @default(uuid())
  tenantId   String
  projectId  String
  assigneeId String?

  title       String
  description String?
  type        String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(TODO)

  taskDate      DateTime?
  estimateHours Decimal?  @db.Decimal(10, 2)

  startedAt  DateTime?
  dueDate    DateTime?
  finishedAt DateTime?

  order       Int?
  dependsOnId String?

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  comments    Comment[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([taskDate])
}

// ======================================================
// ORDENS DE SERVIÇO
// ======================================================

model ServiceOrder {
  id            String  @id @default(uuid())
  tenantId      String
  requesterId   String
  responsibleId String?

  title       String
  description String

  category String?
  system   String?
  unit     String?
  channel  String?
  origin   String?
  tags     String?

  priority Priority?
  status   ServiceOrderStatus @default(OPEN)

  dueDate     DateTime?
  finishedAt  DateTime?
  observation String?

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester   User   @relation("ServiceOrderRequester", fields: [requesterId], references: [id])
  responsible User?  @relation("ServiceOrderResponsible", fields: [responsibleId], references: [id])

  tasks       ServiceOrderTask[]
  comments    Comment[]
  attachments Attachment[]
  satisfaction ServiceOrderSatisfaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([requesterId])
  @@index([responsibleId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([dueDate])
}

model ServiceOrderSatisfaction {
  id              String                     @id @default(uuid())
  tenantId        String
  serviceOrderId  String                     @unique
  requesterId     String
  rating          Int
  comment         String?
  lowRatingReason String?
  followUpStatus  SatisfactionFollowUpStatus?
  followUpNotes   String?
  followedUpById  String?
  followedUpAt    DateTime?
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrder    ServiceOrder               @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  requester       User                       @relation("SatisfactionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  followedUpBy    User?                      @relation("SatisfactionFollowedUpBy", fields: [followedUpById], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, rating])
  @@index([tenantId, followUpStatus])
  @@index([requesterId])
}

// ======================================================
// TAREFAS VINCULADAS À ORDEM DE SERVIÇO
// ======================================================

model ServiceOrderTask {
  id             String  @id @default(uuid())
  tenantId       String
  serviceOrderId String
  responsibleId  String?

  title       String
  description String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(TODO)

  startedAt  DateTime?
  dueDate    DateTime?
  finishedAt DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  responsible  User?        @relation("ServiceOrderTaskResponsible", fields: [responsibleId], references: [id])

  comments    Comment[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([serviceOrderId])
  @@index([responsibleId])
  @@index([status])
  @@index([priority])
}

// ======================================================
// COMENTÁRIOS
// ======================================================

model Comment {
  id       String @id @default(uuid())
  tenantId String
  authorId String

  refType RefType
  refId   String

  text String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  serviceOrderTaskId String?
  serviceOrderTask   ServiceOrderTask? @relation(fields: [serviceOrderTaskId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([authorId])
  @@index([refType, refId])
  @@index([createdAt])
}

// ======================================================
// ANEXOS
// ======================================================

model Attachment {
  id           String @id @default(uuid())
  tenantId     String
  uploadedById String

  refType RefType
  refId   String

  fileName     String
  originalName String?
  mimeType     String
  size         Int

  storageKey String
  url        String?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  serviceOrderId String?
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  serviceOrderTaskId String?
  serviceOrderTask   ServiceOrderTask? @relation(fields: [serviceOrderTaskId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([uploadedById])
  @@index([refType, refId])
  @@index([createdAt])
}

// ======================================================
// REGISTRO DIÁRIO DE ATIVIDADES
// ======================================================

model DailyLog {
  id        String  @id @default(uuid())
  tenantId  String
  userId    String
  projectId String?

  date DateTime
  time String?

  title       String
  type        String?
  description String?

  status     DailyLogStatus     @default(COMPLETED)
  visibility DailyLogVisibility @default(PRIVATE)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([projectId])
  @@index([date])
  @@index([visibility])
}

// ======================================================
// AUDITORIA
// ======================================================

model AuditLog {
  id       String  @id @default(uuid())
  tenantId String
  userId   String?

  action   AuditAction
  entity   String
  entityId String?

  ipAddress String?
  userAgent String?

  metadata Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ======================================================
// ASSINATURAS FUTURAS
// Não será usado no MVP interno.
// ======================================================

model Subscription {
  id       String @id @default(uuid())
  tenantId String @unique

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?

  plan   PlanType      @default(INTERNAL)
  status BillingStatus @default(NONE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

model Notification {
  id        String             @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      NotificationType   @default(INFO)
  entity    NotificationEntity
  entityId  String?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, userId, readAt])
  @@index([entity, entityId])
}

model RolePermission {
  id        String           @id @default(uuid())
  tenantId  String
  role      UserRole
  module    PermissionModule
  canView   Boolean          @default(false)
  canCreate Boolean          @default(false)
  canEdit   Boolean          @default(false)
  canDelete Boolean          @default(false)
  canManage Boolean          @default(false)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, role, module])
  @@index([tenantId, role])
}
