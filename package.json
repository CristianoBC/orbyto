{
  "name": "gestao-projetos-web",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web para gestao de projetos, ordens de servico, tarefas, registros diarios e auditoria.",
  "scripts": {
    "db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "db:format": "prisma format --schema packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "backup:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-database.ps1",
    "backup:uploads": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-uploads.ps1",
    "backup:all": "npm run backup:db && npm run backup:uploads",
    "backup:cleanup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-backups.ps1",
    "maintenance:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/maintenance-check.ps1"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/database"
  ],
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  }
}
