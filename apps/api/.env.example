# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/gestao_projetos_db?schema=public"

# Ambiente e API
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
# Lista separada por vírgulas. Obrigatória em produção (FRONTEND_URL é fallback).
CORS_ORIGIN=http://localhost:3000

# Autenticação (gere um valor aleatório com pelo menos 32 caracteres)
JWT_SECRET=substitua-por-um-segredo-aleatorio-longo-e-unico
JWT_EXPIRES_IN=8h
DEFAULT_TENANT_SLUG=interno
AUTH_ALLOWED_EMAIL_DOMAIN=example.org
USER_INVITE_EXPIRES_HOURS=48

# E-mail (nunca versionar credenciais reais)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=substitua-pela-senha-smtp
MAIL_FROM=no-reply@example.org
MAIL_FROM_NAME=Orbyto

# Uploads (a aplicação limita a configuração a no máximo 50 MB)
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,xls,xlsx,txt,csv

# Alertas de prazo
DEADLINE_ALERTS_ENABLED=true
DEADLINE_ALERTS_CRON=0 8 * * *
DEADLINE_ALERTS_TIMEZONE=America/Sao_Paulo
